---
import BaseLayout from '../layouts/BaseLayout.astro';
import { pagePath } from '../lib/paths';
---
<BaseLayout title="Mill City Web Studio | Minneapolis Web Design" description="Thoughtful custom websites for small businesses, designed and built in Minneapolis by a software engineer with 20+ years of experience.">
  <section class="hero-dark">
    <div class="hero-inner section-shell">
      <div class="hero-copy-block">
        <div class="eyebrow hero-eyebrow">Minneapolis web studio · Small-business focused</div>
        <h1>Bring your business to life <span class="hero-accent">online.</span></h1>
        <p class="hero-copy">We build thoughtful websites for small businesses — designed to reflect your brand, connect with your customers, and bring what makes your business special to life online.</p>
        <div class="button-row">
          <a class="button primary" href={pagePath('work/')}>View my work</a>
          <a class="button secondary" href={pagePath('contact/')}>Submit a request</a>
        </div>
        <div class="hero-footnote">
          <span>20+ years in software engineering</span>
          <span>Minneapolis, Minnesota</span>
        </div>
      </div>
    </div>
  </section>

  <section class="section-shell proof-strip" aria-label="What Mill City Web Studio brings to a project">
    <span>Small business first</span>
    <span>Brand-focused design</span>
    <span>Direct collaboration</span>
    <span>Built with experience</span>
  </section>

  <section class="section-shell services-home home-band home-band-light">
    <div class="eyebrow">What we do</div>
    <h2>We’ll make your brand feel as good online as it does in real life.</h2>
    <div class="card-grid three">
      <article><span>01</span><h3>Website design + build</h3><p>Custom sites shaped around your business, your customers, and the personality behind your brand.</p></article>
      <article><span>02</span><h3>Refresh + improve</h3><p>Modernize an existing site, sharpen the message, improve mobile usability, and make the experience feel more like you.</p></article>
      <article><span>03</span><h3>Hosting + care</h3><p>Deployment, domain setup, content updates, and ongoing support without server headaches or mystery.</p></article>
    </div>
    <a class="text-link" href={pagePath('services/')}>Explore services →</a>
  </section>

  <section class="section-shell approach-section">
    <div class="approach-lead">
      <div class="eyebrow">A smaller way to work</div>
      <h2>We work directly with you to support your business.</h2>
    </div>
    <div class="approach-copy">
      <p>Mill City Web Studio is intentionally small. We work closely with you so communication stays direct, decisions stay practical, and your website supports the business behind it.</p>
      <p>We provide a simple, single point of contact for your project — with thoughtful design, experienced software engineering, and a hands-on approach to understanding what makes your business yours.</p>
    </div>
  </section>

  <section class="section-shell split-section featured-home home-band home-band-dark">
    <div>
      <div class="eyebrow">Featured client work</div>
      <h2>MLAesthetics</h2>
      <p>A complete website for an independent aesthetics studio in Bend, Oregon — from content structure and visual direction through booking integration, local SEO setup, domain configuration, and launch.</p>
    </div>
    <a class="project-preview" href="https://mlaestheticsbend.com/" target="_blank" rel="noreferrer" aria-label="Open the MLAesthetics website in a new tab">
      <div class="browser-bar"><i></i><i></i><i></i><span>mlaestheticsbend.com</span></div>
      <div class="preview-body">
        <span class="preview-kicker">RESULTS-ORIENTED SKIN CARE</span>
        <strong>MLAESTHETICS</strong>
        <em>Bend, Oregon</em>
      </div>
    </a>
  </section>

  <section class="section-shell about-tease home-about">
    <div class="home-about-copy">
      <div class="eyebrow">Rooted in Minneapolis</div>
      <h2>Historic character. Modern work.</h2>
      <p>The Mill City name comes from Minneapolis — flour mills, brick warehouses, riverfront industry, and the way that history has been reworked into something modern.</p>
      <p class="personal-note">It's part of our story too. My wife and I got engaged on the Stone Arch Bridge and were married nearby at St. Anthony Main. Today we're raising three kids here, spending plenty of time around youth sports, and fitting in the Timberwolves and Twins whenever we can.</p>
      <a class="text-link" href={pagePath('about/')}>More about me →</a>
    </div>
  </section>

  <section class="section-shell callout">
    <div><div class="eyebrow">Have a project in mind?</div><h2>Tell us about your business. We’ll take it from there.</h2></div>
    <a class="button primary" href={pagePath('contact/')}>Submit a request</a>
  </section>
</BaseLayout>
